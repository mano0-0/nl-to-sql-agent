# Copy to .env and fill in. .env is gitignored -- never commit a real key.
#
#   cp .env.example .env
#
# Free Groq key (email signup, no credit card): https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default model (openai/gpt-oss-20b).
# List what your key can reach:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_MODEL=openai/gpt-oss-120b

# Only needed for --provider anthropic
# ANTHROPIC_API_KEY=
